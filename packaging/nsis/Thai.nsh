LangString MUI_TEXT_DIRECTORY_SUBTITLE ${LANG_THAI} "เลือกโฟลเดอร์ที่จะติดตั้ง $(^NameDA)"
LangString MUI_TEXT_INSTALLING_TITLE ${LANG_THAI} "กำลังติดตั้ง"
LangString MUI_TEXT_INSTALLING_SUBTITLE ${LANG_THAI} "กรุณารอสักครู่ ระหว่างติดตั้ง $(^NameDA)"
LangString MUI_TEXT_FINISH_TITLE ${LANG_THAI} "ติดตั้งเสร็จแล้ว"
LangString MUI_TEXT_FINISH_SUBTITLE ${LANG_THAI} "ติดตั้งเรียบร้อย"
